{
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet[1m]"
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Monitor",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "PushNotification",
      "TaskStop"
    ]
  },
  "model": "sonnet[1m]",
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "zsh \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "agent-browser@agent-browser": true,
    "context7-plugin@context7-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "rdep-backend-standards@rdep-toolkit": true,
    "rdep-devops-standards@rdep-toolkit": true,
    "rdep-frontend-standards@rdep-toolkit": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true
}
